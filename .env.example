# Server
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=aiagent
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=change-me-in-production-please
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_DAY=10000

# LLM Provider
LLM_PROVIDER=litellm
LLM_BASE_URL=http://localhost:4000
LLM_API_KEY=
LLM_DEFAULT_MODEL=gpt-4o-mini

# Tools
WEB_SEARCH_API_KEY=
TOOLS_MAX_CONCURRENT=10

# External API Keys (for LiteLLM)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
